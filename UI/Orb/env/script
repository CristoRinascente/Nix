import socket

_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

def orb(cmd: str):
    _sock.sendto(cmd.encode(), ("127.0.0.1", 50555))

orb("show 960 540")   # compare con il centro in (960, 540)
orb("glide 1200 400") # si sposta scivolando
orb("ok")             # spunta
orb("error")          # vibra + rosso
orb("hide")           # esce